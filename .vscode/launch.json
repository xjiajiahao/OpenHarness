{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OpenHarness: Attach backend (:5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "justMyCode": false
    },
    {
      "name": "OpenHarness: Agent Loop (--print)",
      "type": "debugpy",
      "request": "launch",
      "module": "openharness",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "OPENHARNESS_API_FORMAT": "copilot"
      },
      "args": [
        "--debug",
        "--permission-mode",
        "full_auto",
        "--max-turns",
        "8",
        "--print",
        "请简要解释当前仓库里 agent loop 的入口与执行流程"
      ]
    }
  ]
}
